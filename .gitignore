# Git ignore file for Alt Text Generator project
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node.js dependencies (if any frontend components are added)
/node_modules
/.pnp
.pnp.js

# Testing artifacts
/coverage

# Next.js build artifacts (if any Next.js components are added)
/.next/
/out/

# Production build artifacts
build
dist

# Miscellaneous system files
.DS_Store  # macOS Finder metadata
*.pem  # Private key files

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local environment files (contain sensitive configuration)
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel deployment files (if using Vercel)
.vercel

# Turborepo cache (if using Turborepo)
.turbo

# TypeScript build info (if TypeScript is added)
*.tsbuildinfo

# Python-specific ignores
# Virtual environments (should not be committed)
vlm-env/
venv/
.venv/
# Python bytecode and cache files
__pycache__/
*.py[cod]  # .pyc, .pyo, .pyd files

.DS_Store
