{
  "name": "posters-science",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "lint:js": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint": "yarn lint:js && yarn lint:prettier",
    "lint:fix": "prettier --write --list-different . && yarn lint:js --fix",
    "postinstall": "nuxt prepare",
    "reset": "rimraf node_modules && rimraf .nuxt && rimraf .output && rimraf dist && yarn install",
    "prune-branches": "git removed-branches --prune --force"
  },
  "dependencies": {
    "@vueuse/core": "13.4.0",
    "vue": "latest"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.14.0",
    "@faker-js/faker": "^9.4.0",
    "@nuxt/devtools": "2.5.0",
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/ui": "^4.0.0",
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^25.0.10",
    "@typescript-eslint/parser": "^8.45.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.2.0",
    "eslint-plugin-vue": "^10.5.0",
    "nuxt": "^4.1.2",
    "prettier": "3.6.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rimraf": "^6.0.1",
    "tailwindcss-debug-screens": "3.0.1",
    "tsx": "4.7.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "zod": "^3.24.1"
  },
  "volta": {
    "node": "22.20.0",
    "yarn": "1.22.22"
  }
}
